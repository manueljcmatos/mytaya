---
import Layout from '../../layouts/Layout.astro';
import VideoGrid from '../../components/VideoGrid';

const lang = 'tl' as const;
const channelId = 'UC528pjVS-RMykQ2VIP4Qs_g';
const apiKey = import.meta.env.PUBLIC_YOUTUBE_API_KEY || '';
const youtubeChannel = `https://www.youtube.com/channel/${channelId}`;
---

<Layout title="Mga Video | MyTaya" lang={lang}>
  <main class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="font-[family-name:var(--font-display)] text-4xl md:text-5xl tracking-wide" style="color: var(--t-text);">
        Mga Video
      </h1>
      <p class="mt-3 text-lg" style="color: var(--t-text-sec);">
        Panoorin ang aming mga prediction videos, trivia, at quiz
      </p>
      <a href={youtubeChannel} target="_blank" rel="noopener" class="btn-primary mt-6 inline-flex">
        I-Subscribe sa YouTube
      </a>
    </div>

    <VideoGrid client:load lang={lang} channelId={channelId} apiKey={apiKey} />
  </main>
</Layout>
